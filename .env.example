# ========================================================
# Configurações de Ambiente - SPAE (Django)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente
# ========================================================

# Configurações Django
DEBUG=True
SECRET_KEY=sua-chave-secreta-de-producao-ou-desenvolvimento
ALLOWED_HOSTS=localhost,127.0.0.1

# ========================================================
# BANCO DE DADOS (SQLite vs PostgreSQL)
# ========================================================
# Para usar SQLite (padrão de desenvolvimento leve):
# DB_ENGINE=sqlite

# Para usar PostgreSQL (produção ou desenvolvimento robusto):
DB_ENGINE=postgresql
DB_NAME=spae_merenda
DB_USER=postgres
DB_PASSWORD=suasenha
DB_HOST=localhost
DB_PORT=5432

# Alternativa via DATABASE_URL única (ex: Railway, Render, Docker):
# DATABASE_URL=postgres://postgres:suasenha@localhost:5432/spae_merenda
